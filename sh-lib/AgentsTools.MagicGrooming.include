#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicGrooming.include -- routine-grooming's own --magic-
## grooming-* operation group for DistroAgentsTools.fn.sh's dispatcher.
## Sourced lazily from the `--magic-grooming-*)` wildcard arm via the
## standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
##
## Each --magic-grooming-to-<state> op is its OWN separate, explicit case
## arm -- deliberately NOT a wildcard match and NOT a shared/parameterized
## helper deriving <state> from an argument, even though today they're
## near-identical. Same reasoning already established in this package for
## --member-upsert-member-inquiry/--member-upsert-inbox-reflection (see
## AgentsTools.Member.include): each op is expected to grow its own
## state-specific validation later, which only works cleanly if each
## already has its own independent code path now. Thin logic over
## --intern-op-board-upsert-move-edit -- this file owns routine-grooming's
## own policy (mandatory owner, auto groomed-at/groomed-from/track), the
## intern-op owns the generic mechanics.
##

case "$1" in

	## <item-filename> --from-state:<state> --owner <value>
	##   [--header:<upsert|append|remove>:name[:value]]...
	##   [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>]
	## Target state is backlog (fixed by this op's own name). --owner and
	## --from-state:<state> are both required; groomed-at (today, UTC),
	## groomed-from (the --from-state value), and track (true) are always
	## auto-stamped, never caller-supplied. --header:*/--upsert-from-stdin/
	## --edit-script-from-stdin:* pass straight through to the intern-op.
	--magic-grooming-to-backlog)
		shift
		local itemName="$1"
		shift || true
		if [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: syntax is <item-filename> --from-state:<state> --owner <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --owner <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date -u +%Y-%m-%d )"
		DistroAgentsTools --intern-op-board-upsert-move-edit backlog "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## pending. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note.
	--magic-grooming-to-pending)
		shift
		local itemName="$1"
		shift || true
		if [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: syntax is <item-filename> --from-state:<state> --owner <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --owner <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date -u +%Y-%m-%d )"
		DistroAgentsTools --intern-op-board-upsert-move-edit pending "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## processed. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note.
	--magic-grooming-to-processed)
		shift
		local itemName="$1"
		shift || true
		if [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: syntax is <item-filename> --from-state:<state> --owner <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --owner <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date -u +%Y-%m-%d )"
		DistroAgentsTools --intern-op-board-upsert-move-edit processed "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			"${passthrough[@]}"
		return $?
	;;

	## [--state <state>]... [--header <name>]... -- read-only discovery:
	## which board items exist at which relative path, optionally with
	## specific frontmatter header values pulled alongside each one. Answers
	## "where does this item actually sit right now" so a caller doesn't
	## have to guess --from-state for --magic-grooming-to-*. No --state
	## means every real board state. One line per item:
	## "<state>/<item-filename>" then, for each requested header, a tab and
	## "<name>=<value>" (empty value if the field is absent).
	--magic-grooming-input-scan)
		shift
		local boardRoot="$HOME/.claude/skills/magic-team/board"
		local states=() headers=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--state)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-input-scan: --state: value required" >&2
						set +e ; return 1
					fi
					case "$2" in
						backlog|pending|running|blocked|parked|processed|archived|retained|cleanup)
						;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --magic-grooming-input-scan: --state: invalid state: $2" >&2
							set +e ; return 1
						;;
					esac
					states+=( "$2" )
					shift 2
				;;
				--header)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-input-scan: --header: value required" >&2
						set +e ; return 1
					fi
					headers+=( "$2" )
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-input-scan: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ ${#states[@]} -eq 0 ] ; then
			states=( backlog pending running blocked parked processed archived retained cleanup )
		fi

		local state f base line h val
		for state in "${states[@]}" ; do
			for f in "$boardRoot/$state"/*.md ; do
				[ -f "$f" ] || continue
				base="$( basename "$f" )"
				line="$state/$base"
				for h in "${headers[@]}" ; do
					val="$( LC_ALL=C sed -n "s/^$h: //p" "$f" | head -n 1 )"
					line="$line	$h=$val"
				done
				printf '%s\n' "$line"
			done
		done
		return 0
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
