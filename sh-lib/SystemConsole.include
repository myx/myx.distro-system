#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

set -e
case "$1" in
	## the single reader of the project-declared commands index, serving both consumers:
	## the console PATH fragment (default) and the completion name list (--completion).
	--shell-path-append)
		set +ex
		[ -f "$MMDAPP/.local/distro-commands.txt" ] || return 0
		case "$2" in
			--completion)
				awk '!seenCommand[$2]++ { print $2 ".fn.sh" ; }' "$MMDAPP/.local/distro-commands.txt"
			;;
			*)
				## The derived line the source-prepare builder writes beside the index (the distinct sh-scripts folders, colon-joined): one read
				## and a match in the shell a prompt, no awk. Without it, the index is walked by awk as before.
				if [ -f "$MMDAPP/.local/distro-command-path.txt" ] && [ ! "$MMDAPP/.local/distro-commands.txt" -nt "$MMDAPP/.local/distro-command-path.txt" ] ; then
					IFS=: read -r -a shellPathFolders < "$MMDAPP/.local/distro-command-path.txt" || shellPathFolders=()
					for shellPathFolder in ${shellPathFolders[@]+"${shellPathFolders[@]}"} ; do
						case "$shellPathFolder" in ''|*[[:space:]]*) continue ;; esac
						case ":$PATH:" in *":$shellPathFolder:"*) ;; *) printf ':%s' "$shellPathFolder" ;; esac
					done
				else
					## ENVIRON, never -v: -v escape-decodes the value, and the dedup below then never matches,
					## so PROMPT_COMMAND re-appends the same directory every prompt until PATH grows the console to a crawl.
					awk '!seenScriptsDir[$3]++ && index( ":" ENVIRON["PATH"] ":", ":" $3 ":" ) == 0 { printf ":%s", $3 ; }' "$MMDAPP/.local/distro-commands.txt"
				fi
			;;
		esac
		return 0
	;;
	--completion-*)
		( . "$MDLT_ORIGIN/myx/myx.distro-system/sh-lib/SystemConsole.CompletionCommands.include" )
		return 0
	;;
	''|--help)
		shift
		( . "$MDLT_ORIGIN/myx/myx.distro-system/sh-lib/help/Help.ConsoleDistro.include" )
		return 0
	;;
	*)
		echo "SourceConsole: Invalid argument: $1" >&2
		set +e ; return 1
	;;
esac
