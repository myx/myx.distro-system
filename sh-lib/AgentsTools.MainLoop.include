#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MainLoop.include -- the --main-loop-* operation-group body for
## DistroAgentsTools.fn.sh's single dispatcher, sourced lazily (only when $1
## matches --main-loop-*) from that file's own `--main-loop-*)` arm, via the
## absolute $MDLT_ORIGIN-based path used for every cross-file source in this
## family.
##
## Not standalone-executable: relies on being dot-sourced into
## DistroAgentsTools's own function scope for $1/$@ and the $MDSC_CMD local.
##
## --main-loop-lock-acquire/-heartbeat/-release/-status are thin stubs here,
## each forwarding straight through to its --magic-heartbeat-lock-*
## equivalent (AgentsTools.MagicHeartbeat.include) -- same lock, same
## mechanics, unchanged behavior; this file no longer implements the lock
## itself.
##

case "$1" in

	--main-loop-lock-acquire)
		shift
		DistroAgentsTools --magic-heartbeat-lock-acquire "$@" || return 1
		return 0
	;;

	--main-loop-lock-heartbeat)
		shift
		DistroAgentsTools --magic-heartbeat-lock-heartbeat "$@" || return 1
		return 0
	;;

	--main-loop-lock-release)
		shift
		DistroAgentsTools --magic-heartbeat-lock-release "$@" || return 1
		return 0
	;;

	--main-loop-lock-status)
		shift
		DistroAgentsTools --magic-heartbeat-lock-status "$@" || return 1
		return 0
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
