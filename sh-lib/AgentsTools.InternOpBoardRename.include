#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpBoardRename.include -- the --intern-op-board-rename op
## for DistroAgentsTools.fn.sh's dispatcher. Sourced lazily from that exact
## op's own dispatcher arm via the standard $MDLT_ORIGIN-based path. Not
## standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD. One
## intern-op primitive per file, same convention as
## AgentsTools.InternOpBoardUpsertMoveEdit.include -- not bundled with it.
##
## No --help entry: internal plumbing, non-default/rare utility.
##

case "$1" in

	## <old-name> <new-name> [--do-not-track] -- rare fixup/backfill only
	## (normal rename-like outcomes go through the Merge pattern: new item,
	## supersedes/superseded-by, old item retired -- not this). Steps, in
	## this order so the fresh supersedes field is never itself rewritten
	## by the first step:
	##   1. Bulk literal-string fix-up of every OTHER board item's own
	##      cross-references to <old-name>, so they point at <new-name>.
	##   2. If a real item file is named exactly <old-name>, rename it to
	##      <new-name> (same state) and stamp
	##      `supersedes: <old-name> (renamed)` on it -- always, in every
	##      scenario, same audit trail the Merge pattern already keeps.
	##   3. Unless --do-not-track: leave a minimal husk item at
	##      board/processed/<old-name> carrying
	##      `superseded-by: <new-name> (renamed)`, so a stale reference
	##      that missed step 1 still resolves forward. --do-not-track
	##      skips this -- <old-name> then stops existing anywhere.
	##
	## gsub's one-line inline AWK (below): a single-line literal
	## substitution, not extracted by this pass -- whether it belongs in
	## scope for this package's own externalize-awk/py convention is open,
	## not decided by this comment.
	--intern-op-board-rename)
		shift
		local oldName="$1"
		shift || true
		local newName="$1"
		shift || true
		if [ -z "$oldName" ] || [ -z "$newName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-rename: syntax is <old-name> <new-name> [--do-not-track]" >&2
			set +e ; return 1
		fi
		local doNotTrack="false"
		if [ "$1" = "--do-not-track" ] ; then
			doNotTrack="true"
			shift
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-rename: invalid option: $1" >&2
			set +e ; return 1
		fi

		local boardRoot="$HOME/.claude/skills/magic-team/board"
		local oldEscaped
		oldEscaped="$( printf '%s' "$oldName" | LC_ALL=C sed -e 's/[.[\*^$/]/\\&/g' )"
		local f base touched=0
		for f in "$boardRoot"/*/*.md ; do
			[ -f "$f" ] || continue
			base="$( basename "$f" )"
			[ "$base" = "$oldName" ] && continue
			if grep -q -F -- "$oldName" "$f" ; then
				local tmp
				tmp="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-rename.XXXXXX" )" || { set +e ; return 1 ; }
				LC_ALL=C awk -v old="$oldEscaped" -v new="$newName" '{ gsub(old, new) ; print ; }' "$f" > "$tmp"
				mv "$tmp" "$f"
				touched=$(( touched + 1 ))
			fi
		done

		## Plain `mv` does the actual filename change first (same state) --
		## the intern-op's <item-filename> is shared by both its from- and
		## to-path construction, so it has no way to rename a file, only to
		## move/edit one under a FIXED name. Once the file is already sitting
		## under <new-name>, the intern-op call below is a legal in-place
		## edit (--from-state == <to-state>, same filename both sides) --
		## purely to stamp `supersedes`, not a second rename attempt.
		local state oldFile renamed="false"
		for state in backlog pending running blocked parked processed archived retained cleanup ; do
			oldFile="$boardRoot/$state/$oldName"
			if [ -f "$oldFile" ] ; then
				mv "$oldFile" "$boardRoot/$state/$newName"
				if ! DistroAgentsTools --intern-op-board-upsert-move-edit "$state" "$newName" --from-state:"$state" --header:upsert:supersedes:"$oldName (renamed)" ; then
					echo "⛔ ERROR: $MDSC_CMD --intern-op-board-rename: renamed $oldFile -> $newName but failed to stamp supersedes" >&2
					set +e ; return 1
				fi
				renamed="true"
				break
			fi
		done

		if [ "$doNotTrack" = "false" ] ; then
			if ! printf '%s\n' '---
type: note
superseded-by: '"$newName"' (renamed)
---
Renamed to `'"$newName"'`.' | DistroAgentsTools --intern-op-board-upsert-move-edit processed "$oldName" --create --upsert-from-stdin >/dev/null ; then
				echo "⛔ ERROR: $MDSC_CMD --intern-op-board-rename: failed to leave husk at board/processed/$oldName" >&2
				set +e ; return 1
			fi
		fi

		echo "# $MDSC_CMD --intern-op-board-rename: $oldName -> $newName ($touched cross-reference file(s), item-renamed=$renamed, husk-left=$( [ "$doNotTrack" = "false" ] && echo true || echo false ))" >&2
		return 0
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
