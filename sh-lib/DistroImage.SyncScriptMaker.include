#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

case "$1" in
	--intern-ssh-mx-root-temp-block)
		# make a socket-dir and ensure it’s cleaned up
		echo 'if [ -n "$MMDAPP" ] && [ -d "$MMDAPP/.local" ]; then'
		echo '  tmpdir="$MMDAPP/.local/temp/ssh"'
		echo 'else'
		# no workspace: the running user's own ssh folder, never the system temp folder (shared with every user of the machine)
		echo '  [ -d "${HOME:?}/.ssh" ] || { mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh" ; }'
		echo '  tmpdir="${HOME:?}/.ssh/cmx"'
		echo '  [ -d "$tmpdir" ] || { mkdir -p "$tmpdir" && chmod 700 "$tmpdir" ; }'
		echo 'fi'
		echo 'mkdir -p "$tmpdir"'

		# shorten long tmpdir paths via a symlink if over 60 chars: a control socket path must stay under about 104 bytes,
		# and the link stands in the same private ssh folder of the running user
		echo 'if [ ${#tmpdir} -gt 60 ]; then'
		echo '  [ -d "${HOME:?}/.ssh" ] || { mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh" ; }'
		echo '  shorttmp="${HOME:?}/.ssh/cmx-$$"'
		echo '  ln -s "$tmpdir" "$shorttmp"'
		echo '  tmpdir="$shorttmp"'
		echo '  syncExitCleanup="$syncExitCleanup rm -f \"$shorttmp\" ;"'
		echo '  trap "$syncExitCleanup" EXIT'
		[ -z "$MDSC_DETAIL" ] || printf '  echo "🍏 %s: link short control master path: $shorttmp -> $tmpdir" >&2\n' "$MDSC_CMD"
		echo 'fi'

		# echo "trap 'rm -rf \"\$tmpdir\" ; popd' EXIT"
		# echo 'pushd "$tmpdir" >/dev/null || exit 1'

		return 0
	;;
	--intern-stdin-parallel-block)
		## myx.common lib/parallel runs a command line: the job prefix goes to it once, and the jobs follow on stdin
		printf '( Parallel -S --workers %s %s ) <<XARGS_INPUT\n' "$parallelLimit" "$syncJobPrefix"
		local itemTarget itemSource useBranch
		while read -r itemTarget itemSource useBranch _; do
			echo "$syncJobCommand" "$itemTarget" "$itemSource" "$useBranch"
		done
		printf 'XARGS_INPUT\n\n'
		return 0
	;;
	--intern-stdin-xargs-block)
		## A failed job exits 1, never 255: xargs stops at a 255 (ssh's own), and the rest would die with the run.
		## xargs runs a file, never a shell function. A bundled job goes through the generated job file.
		if [ -n "$syncPortable" ] ; then
			printf '( %s | %s ) <<XARGS_INPUT\n' \
				"tr '\n' '\0'" \
				"xargs -0 -P $parallelLimit -n 1 -- \"\$syncJobFile\""
			local itemTarget itemSource useBranch
			while read -r itemTarget itemSource useBranch _; do
				echo "$itemTarget" "$itemSource" "$useBranch"
			done
		else
			printf '( %s | %s ) <<XARGS_INPUT\n' \
				"tr '\n' '\0'" \
				"xargs -0 -P '$parallelLimit' -I% -- sh -c '$syncJobPrefix % || exit 1'"
			local itemTarget itemSource useBranch
			while read -r itemTarget itemSource useBranch _; do
				echo "$syncJobCommand" "$itemTarget" "$itemSource" "$useBranch"
			done
		fi
		printf 'XARGS_INPUT\n\n'
		return 0
	;;
	--intern-stdin-batches-block)
		## the script itself runs the jobs: one at a time it needs no background and no wait at all
		local itemTarget itemSource useBranch rowCounter batchLimit
		if [ "$parallelLimit" = 1 ] ; then
			while read -r itemTarget itemSource useBranch _; do
				echo "$syncJobPrefix $syncJobCommand" "$itemTarget" "$itemSource" "$useBranch" ' || batchFailed=1'
			done
			## every job gets its chance, and a failed one still reaches the caller
			echo '[ -z "$batchFailed" ] || exit 1'
			return 0
		fi
		batchLimit="$( printf '@%.0s' $(seq 1 $parallelLimit) )"
		while read -r itemTarget itemSource useBranch _; do
			echo "$syncJobPrefix $syncJobCommand" "$itemTarget" "$itemSource" "$useBranch" ' </dev/null & batchJobs="$batchJobs $!" # parallel'
			rowCounter="${rowCounter}@"
			if [ "$rowCounter" = "$batchLimit" ] ; then
				echo 'for batchJob in $batchJobs ; do wait "$batchJob" || batchFailed=1 ; done ; batchJobs=""'
				rowCounter=""
			fi
		done
		echo 'for batchJob in $batchJobs ; do wait "$batchJob" || batchFailed=1 ; done ; batchJobs=""'
		## every job gets its chance, and a failed one still reaches the caller
		echo '[ -z "$batchFailed" ] || exit 1'
		return 0
	;;
esac

## ─── the three independent axes ──────────────────────────────────────────────
##   bundling  the floor of what the script may find. --portable bundles everything, so it runs on an unknown host.
##             Without it the floor is the installed myx.common, and anything better on the host may be used.
##   runner    how the jobs are run: the installed myx.common's own Parallel, in-shell batches, or xargs.
##   count     how many run at once: --parallel [N] (8 by default), --sequence the same at 1.
##
## --xargs is the caller's own override and replaces every runner, in every mode. The generator never picks it by itself.
local SYNC_NO_SSH_MX= SYNC_SSH_DEFAULTS= SYNC_ONE_SSH_MX=
local syncPortable= syncUseXargs= syncSequence= syncParallelLimit=
while [ $# -gt 0 ] ; do
	case "$1" in
		--no-ssh-mx)
			[ -z "$MDSC_DETAIL" ] || echo "🛠️ $MDSC_CMD: $1: no ssh multiplexing" >&2
			SYNC_NO_SSH_MX=$1
			shift
		;;
		--ssh-defaults)
			[ -z "$MDSC_DETAIL" ] || echo "🛠️ $MDSC_CMD: $1: use default ssh settings" >&2
			SYNC_SSH_DEFAULTS=$1
			shift
		;;
		--one-ssh-mx)
			[ -z "$MDSC_DETAIL" ] || echo "🛠️ $MDSC_CMD: $1: one ssh control master at most" >&2
			SYNC_ONE_SSH_MX=$1
			shift
		;;
		--xargs)
			[ -z "$MDSC_DETAIL" ] || echo "🛠️ $MDSC_CMD: $1: jobs run by xargs, not by the runner the floor picks" >&2
			syncUseXargs=$1
			shift
		;;
		--parallel|--portable)
			if [ "$1" = "--portable" ] ; then
				[ -z "$MDSC_DETAIL" ] || echo "🛠️ $MDSC_CMD: $1: everything bundled, the script runs on an unknown host" >&2
				syncPortable=$1
			fi
			shift
			## both may carry the count, as --portable always could
			case "$1" in
				''|*[!0-9]*) ;;
				*)
					[ -z "$MDSC_DETAIL" ] || echo "🛠️ $MDSC_CMD: $1 jobs at once" >&2
					syncParallelLimit=$1
					shift
				;;
			esac
		;;
		--sequence)
			[ -z "$MDSC_DETAIL" ] || echo "🛠️ $MDSC_CMD: $1: one job at a time" >&2
			syncSequence=$1
			shift
		;;
		--obsolete)
			## the old in-shell sequence: bundled, and one at a time
			[ -z "$MDSC_DETAIL" ] || echo "🛠️ $MDSC_CMD: $1: bundled jobs, one at a time" >&2
			syncPortable=$1
			syncSequence=$1
			shift
		;;
		*)
			echo "$MDSC_CMD: ⛔ ERROR: invalid sync option: $1 ($MDSC_OPTION, $@)" >&2
			set +e ; return 1
		;;
	esac
done

local syncType
case "$useStage" in
	*-pull) # gitClonePull | GitClonePull
		syncType="Pull"
	;;
	*-push) # gitCloneSync | GitCloneSync
		syncType="Sync"
	;;
	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid build stage ($useStage) ($MDSC_OPTION, $@)" >&2
		set +e ; return 1
	;;
esac

local syncCommandPath=""
local syncCommandName=""

[ "$syncType" != "Pull" ] || [ -n "$syncPortable" ] || {
	case "$useStage" in
		source-*)
			case "$MDSC_INMODE" in
				source) syncType=Sync ;;
			esac
		;;
	esac
}


if \
	[ -x "$MDLT_ORIGIN/myx/myx.common/os-myx.common/host/tarball/share/myx.common/bin/git/clone${syncType}.Common" ]
then
	syncCommandPath="$MDLT_ORIGIN/myx/myx.common/os-myx.common/host/tarball/share/myx.common/bin"
	syncCommandName="git/clone${syncType}"
elif \
	command -v myx.common >/dev/null 2>&1
then
	syncCommandPath="$( dirname "$( dirname "$( myx.common which git/clone${syncType} )" )" )"
	syncCommandName="git/clone${syncType}"
	if [ ! -x "$syncCommandPath/$syncCommandName.Common" ] ; then
		echo "$MDSC_CMD: ⛔ ERROR: myx.common which git/clone${syncType} failed ($MDSC_OPTION, $@)" >&2
		set +e ; return 1
	fi
else
	echo "$MDSC_CMD: ⛔ ERROR: can't locate myx.common ($useStage) ($MDSC_OPTION, $@)" >&2
	set +e ; return 1
fi

## count: one job at a time says the rest of this
[ -z "$syncSequence" ] || syncParallelLimit=1
local parallelLimit="${syncParallelLimit:-8}"

## runner: a bundled script has no Parallel to call, so it runs the jobs itself, unless the caller asks for xargs
local syncRunner
if [ -n "$syncUseXargs" ] ; then
	syncRunner="xargs"
elif [ -n "$syncPortable" ] ; then
	syncRunner="batches"
else
	syncRunner="parallel"
fi

## one job: the installed command, or the function of the same name bundled with the script
local syncJobPrefix syncJobCommand
if [ -n "$syncPortable" ] ; then
	syncJobPrefix="Prefix -o -2"
	syncJobCommand="GitClone${syncType}"
else
	syncJobPrefix="myx.common lib/prefix -o -3"
	syncJobCommand="myx.common git/clone${syncType}"
fi

## the bundled half, read once. It goes where the jobs run: the script, or the job file under xargs
local syncBundleText=""
if [ -n "$syncPortable" ] ; then
	syncBundleText="$(
		printf '\n# 📚 lib/sedLineReader\n'
		grep -v -e '^[[:space:]]*$' -e '^[[:space:]]*#' "$syncCommandPath/lib/sedLineReader.${UNAME:-$(uname -s)}"
		printf '\n# 📚 lib/prefix\n'
		grep -v -e '^[[:space:]]*$' -e '^[[:space:]]*#' "$syncCommandPath/lib/prefix.Common"
		printf '\n# 📘 %s\n' "$syncCommandName"
		grep -v -e '^[[:space:]]*$' -e '^[[:space:]]*#' "$syncCommandPath/$syncCommandName.Common"
	)"
fi

local REPO_LIST; REPO_LIST="$(DistroImageSync --intern-print-repo-list-from-stdin)"

if [ -z "$REPO_LIST" ] ; then
	echo "$MDSC_CMD: ⛔ ERROR: empty repo list:" >&2
	set +e ; return 1
fi

echo 'set -e' 
[ full != "$MDSC_DETAIL" ] || echo 'set -x'
printf 'export MMDAPP="${MMDAPP:-%s}"\n' "$MMDAPP"
echo 'mkdir -p "$MMDAPP/source"'
echo 'cd "$MMDAPP/source"'
[ "$syncRunner" != parallel ] || printf '. "%s/lib/parallel.Common"\n' "$syncCommandPath"
echo 'syncJobs="" syncFailed="" syncExitCleanup="" batchJobs="" batchFailed="" # block pids, whether one failed, what to remove, one batch, and its own failure'
echo

# 1) Common SSH flags (cipher-suite, KEX, hostkeys, compression, batching…)
echo 'export SSH_COMMON_OPTS="\'
echo '  -T -q \'
echo '  -o BatchMode=yes \'
echo '  -o ConnectTimeout=${MYX_GIT_CONNECT_TIMEOUT:-15} \' # an unreachable host must not hold the whole run
[ -n "$SYNC_SSH_DEFAULTS" ] || {
	echo '  -4 \'
	# bitbucket needs aes128-ctr:
	echo '  -o Ciphers=chacha20-poly1305@openssh.com,aes128-gcm@openssh.com,aes256-gcm@openssh.com,aes128-ctr \'
	echo '  -o KexAlgorithms=curve25519-sha256,diffie-hellman-group1-sha1 \'
	echo '  -o HostKeyAlgorithms=ssh-ed25519,ecdsa-sha2-nistp256,ssh-rsa \'
	echo '  -o Compression=yes \'
}
echo '"'

## the bundled half goes where the jobs run: in the script itself, or in the file xargs runs
if [ -n "$syncPortable" ] && [ "$syncRunner" != xargs ] ; then
	printf '%s\n' "$syncBundleText"
	printf '\n# 🧾 Image Sync main block\n'
fi

## xargs runs a file, never a shell function. A bundled job is written to one, made executable, and removed at the end
if [ -n "$syncPortable" ] && [ "$syncRunner" = xargs ] ; then
	echo 'if [ -n "$MMDAPP" ] && [ -d "$MMDAPP/.local" ]; then'
	echo '  syncJobDir="$MMDAPP/.local/temp"'
	echo 'else'
	echo '  syncJobDir="${HOME:?}/.local/temp"'
	echo 'fi'
	echo 'mkdir -p "$syncJobDir"'
	echo 'syncJobFile="$syncJobDir/sync-job.$$.sh"'
	echo "cat > \"\$syncJobFile\" <<'SYNC_JOB_FILE_END'"
	echo '#!/bin/sh'
	printf '%s\n' "$syncBundleText"
	echo 'set -- $1'
	printf '%s %s "$@"\n' "$syncJobPrefix" "$syncJobCommand"
	echo 'SYNC_JOB_FILE_END'
	echo 'chmod 700 "$syncJobFile"'
	echo 'syncExitCleanup="$syncExitCleanup rm -f \"$syncJobFile\" ;"'
	echo 'trap "$syncExitCleanup" EXIT'
fi

## Only a genuine ssh remote takes a control master: `ssh://`, or the scp form `host:path`. Every other
## form (`https://`, `git://`, `file://`, a local directory) is left to GitClonePull on its own.
local SSH_REPO_LIST=$( printf '%s\n' "$REPO_LIST" | awk '
	$2 ~ /^ssh:\/\// { print ; next }
	$2 ~ /:\/\// { next }
	$2 ~ /^[^\/]*:/ { print }
' )
local SSH_USE_ROOT_MX SSH_ROOT_MX_USED

# ─── configure SSH for multiplexing via this temp dir ────────────────────────
if [ -z "$SYNC_NO_SSH_MX" ] && [ "$(printf '%s\n' "$SSH_REPO_LIST" | wc -l)" -gt 2 ] ; then

	local MX_SSH_REPO_LIST=$(
		printf '%s\n' "$SSH_REPO_LIST" \
		| while read itemTarget url rest; do
			# extract “host port” from $url
			printf '%s\n' "$url" \
			| sed -nE 's#^(ssh://)?([^@]+@)?([^:/]+)(:([0-9]+))?.*#\3 \5#p' \
			| while read -r SSH_HOST SSH_PORT ; do
				echo "$SSH_HOST ${SSH_PORT:-22} $itemTarget $url $rest"
			done
		done
	)

	local SSH_MX_STOP_LIST=" bitbucket.org "   # space-separated and space-padded list

	while read -r SSH_HOST SSH_PORT ; do
	
		if [ "${SSH_MX_STOP_LIST#* $SSH_HOST }" != "$SSH_MX_STOP_LIST" ] ; then
			echo "## server $SSH_HOST is in SSH_MX_STOP_LIST - not using control master - inline"
			continue
		fi

		local SERVER_REPO_LIST=$(
			echo "$MX_SSH_REPO_LIST" | grep -e "^$SSH_HOST $SSH_PORT " | cut -d' ' -f3-
		)

		# one master per 4 repos, capped at 8
		local SERVER_REPOS=$(printf '%s\n' "$SERVER_REPO_LIST" | echo $(wc -l))
		local MASTER_COUNT=$(( ( $SERVER_REPOS + 6) / 7 )) ; [ "$MASTER_COUNT" -gt 8 ] && MASTER_COUNT=8

		if [ "$MASTER_COUNT" = 1 ] || [ -n "$SYNC_ONE_SSH_MX" ] || [ "$parallelLimit" = 1 ] ; then
			if [ "$SERVER_REPOS" = 1 ] ; then
				echo "## server $SSH_HOST:$SSH_PORT exactly one repo on this server - inline"
				continue
			fi
			echo "## server $SSH_HOST:$SSH_PORT not enough repos for multiplexing but more than one ($SERVER_REPOS) -- goes to global batch"
			[ -n "$SSH_USE_ROOT_MX" ] || {
				SSH_USE_ROOT_MX=1
			}
			continue
		fi

		echo "## server $SSH_HOST:$SSH_PORT ($SERVER_REPOS repos) will do multiple control masters"

		SSH_USE_ROOT_MX=1
		if [ -z "$SSH_ROOT_MX_USED" ] ; then
			SSH_USE_ROOT_MX=1
			SSH_ROOT_MX_USED=1
			(
				set -- --intern-ssh-mx-root-temp-block
				. "$MDLT_ORIGIN/myx/myx.distro-system/sh-lib/DistroImage.SyncScriptMaker.include" 
			)
		fi

		echo "("
		echo

		echo 'ssh -MNf $SSH_COMMON_OPTS -o ControlMaster=yes -o ControlPath="$tmpdir/%r,%h,%p" -o ControlPersist=3m -p' "${SSH_PORT:-22}" git@"$SSH_HOST" ' || : &'
		for i in $(seq 1 $((MASTER_COUNT-1))); do
			# first master uses default, extras use "p1","p2",…
			local label=$([ "$i" -eq 0 ] && echo '%r,%h,%p' || echo "%r,%h,%p,$i")
			echo "ssh -MNf \$SSH_COMMON_OPTS -o ControlMaster=yes -o ControlPath=\"\$tmpdir/$label\" -o ControlPersist=3m -p ${SSH_PORT:-22} git@$SSH_HOST || : &"
		done
		echo wait
		
		# export a minimal, high-throughput SSH for Git
		echo "export GIT_SSH_COMMAND=\"sh -c '"
		## a hash of the ssh call (host and repo) picks the master: the same repo always takes the same one, and a burst spreads
		echo "idx=\\\$(( \\\$(printf %s \\\"\\\$*\\\" | cksum | cut -d\\\" \\\" -f1) % $MASTER_COUNT ))"
		echo "slot=\\\$( [ \\\"\\\$idx\\\" -eq 0 ] && echo \\\"%r,%h,%p\\\" || echo \\\"%r,%h,%p,\\\$idx\\\" )"
		echo "exec ssh \$SSH_COMMON_OPTS -o ControlMaster=auto -o ControlPath=\$tmpdir/\\\$slot -o ControlPersist=3m \\\"\\\$@\\\""
		echo "' ssh\""

		printf '%s\n' "$SERVER_REPO_LIST" \
		| (
			set -- --intern-stdin-${syncRunner}-block
			. "$MDLT_ORIGIN/myx/myx.distro-system/sh-lib/DistroImage.SyncScriptMaker.include" 
		)

		echo ") & syncJobs=\"\$syncJobs \$!\""

		REPO_LIST="$( printf '%s\n' "$REPO_LIST" | grep -Fvxf <( printf '%s\n' "$SERVER_REPO_LIST" ) || : )"

	done <<< "$( printf '%s\n' "$MX_SSH_REPO_LIST" | cut -d' ' -f1,2 | sort -u )"

fi

if [ -n "$REPO_LIST" ] ; then
	if [ -n "$SSH_USE_ROOT_MX" ] ; then
		if [ -z "$SSH_ROOT_MX_USED" ] ; then
			(
				set -- --intern-ssh-mx-root-temp-block
				. "$MDLT_ORIGIN/myx/myx.distro-system/sh-lib/DistroImage.SyncScriptMaker.include" 
			)
		fi
		# export a minimal, high-throughput SSH for Git
		echo 'export GIT_SSH_COMMAND="ssh $SSH_COMMON_OPTS -o ControlMaster=auto -o ControlPath=$tmpdir/%r,%h,%p -o ControlPersist=3m"'
	else
		echo 'export GIT_SSH_COMMAND="ssh $SSH_COMMON_OPTS"'
	fi

	## backgrounded and waited like every server block: a foreground failure under set -e left the others running orphaned
	echo "("
	printf '%s\n' "$REPO_LIST" \
	| (
		set -- --intern-stdin-${syncRunner}-block
		. "$MDLT_ORIGIN/myx/myx.distro-system/sh-lib/DistroImage.SyncScriptMaker.include" 
	)
	echo ") & syncJobs=\"\$syncJobs \$!\""
fi

## every block is backgrounded, so the script waits for them all: a bare `wait` answers zero, and a failed block must reach the caller
echo 'for syncJob in $syncJobs ; do wait "$syncJob" || syncFailed=1 ; done'
## the run ends its own control masters: a master started -MNf holds no client session, so ControlPersist never ends it
echo '[ -z "${tmpdir:-}" ] || for syncMx in "$tmpdir"/*,* ; do { [ -S "$syncMx" ] && ssh -o ControlPath="$syncMx" -O exit sync-mx 2> /dev/null ; } || : ; done'
echo '[ -z "$syncFailed" ] || exit 1'

#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only
